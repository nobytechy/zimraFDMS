# Browser (Vite) — public values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server (Netlify function) — SECRET, set in Netlify → Environment variables, never in the browser
DATABASE_URL=postgresql://postgres:...@db.xxxx.supabase.co:5432/postgres   # direct or session-mode (5432), NOT the 6543 pooler
FDMS_MASTER_KEY=                  # 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
FDMS_MODEL_NAME=ZimFDMS           # must match the device model registered with ZIMRA
FDMS_MODEL_VERSION=1.0
FDMS_TEST_URL=https://fdmsapitest.zimra.co.zw
# FDMS_LIVE_URL=https://fdmsapi.zimra.co.zw   # leave unset to keep Live DISABLED until the test run passes
